# 7.3.1.1 Default Folder Access Control
# Internal directory - deny all HTTP access.
# Covers: DATA_CONTRACT.md, BUILD_STEPS.md (internal planning docs, not web-served)

<IfModule mod_authz_core.c>
    Require all denied
</IfModule>
<IfModule !mod_authz_core.c>
    Order deny,allow
    Deny from all
</IfModule>
