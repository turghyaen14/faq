# 7.3.1.1 Default Folder Access Control
# Internal directory - deny all HTTP access.
# Covers: serialized/gzip-compressed cache files (company_data_*, faq_data_*, schema_individual_*)

<IfModule mod_authz_core.c>
    Require all denied
</IfModule>
<IfModule !mod_authz_core.c>
    Order deny,allow
    Deny from all
</IfModule>
