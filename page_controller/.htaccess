# 7.3.1.1 Default Folder Access Control
# Internal directory - deny all HTTP access.
# Covers: BaseTemplateController.class.php, IndexPageController.class.php,
#         CompanyPageController.class.php, IndividualPageController.class.php,
#         SearchPageController.class.php, AboutUsPageController.class.php,
#         NotFound404PageController.class.php

<IfModule mod_authz_core.c>
    Require all denied
</IfModule>
<IfModule !mod_authz_core.c>
    Order deny,allow
    Deny from all
</IfModule>
