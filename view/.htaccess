# 7.3.1.1 Default Folder Access Control
# Internal directory - deny all HTTP access.
# Covers: header.html, footer.html, index.html, companyIndex.html,
#         individualFaq.html, searchedQuery.html, aboutUs.html,
#         notfound404.html, test.html

<IfModule mod_authz_core.c>
    Require all denied
</IfModule>
<IfModule !mod_authz_core.c>
    Order deny,allow
    Deny from all
</IfModule>
