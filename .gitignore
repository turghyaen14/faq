# ── Secrets / credentials (never commit) ──────────────────────────────
config/db_connection.php

# ── Runtime object cache (generated) ──────────────────────────────────
cache_object/*
!cache_object/.htaccess

# ── Visitor logs (contain visitor IP addresses) ───────────────────────
visitor_log/*
!visitor_log/.htaccess

# ── Generated sitemaps ────────────────────────────────────────────────
sitemaps/*
!sitemaps/.htaccess
.sitemap_last_run

# ── Local tooling / editor ────────────────────────────────────────────
.claude/settings.json

# ── OS junk ───────────────────────────────────────────────────────────
Thumbs.db
Desktop.ini
.DS_Store
