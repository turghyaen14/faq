# 7.3.1.1 Default Folder Access Control
# Internal directory - deny all HTTP access.
# Covers: Company.class.php, Faq.class.php, Helper.class.php, ObjectCache.class.php

<IfModule mod_authz_core.c>
    Require all denied
</IfModule>
<IfModule !mod_authz_core.c>
    Order deny,allow
    Deny from all
</IfModule>
